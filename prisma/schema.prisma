
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  CUSTOMER

  @@map("roles")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(100)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  orders       Order[]

  @@map("users")
}

enum OrderStatus {
  PAID
  PENDING
  REFUNDED
  FAILED

  @@map("order_statuses")
}

model Order {
  id         String      @id @default(uuid()) @db.Uuid
  customerId String      @map("customer_id") @db.Uuid
  status     OrderStatus @default(PENDING)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz
  customer   User        @relation(fields: [customerId], references: [id])
  items      OrderItem[]

  @@index([customerId], map: "idx_orders_customer_id")
  @@index([createdAt], map: "idx_orders_created_at")
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid()) @db.Uuid
  orderId   String  @map("order_id") @db.Uuid
  productId String  @map("product_id") @db.Uuid
  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(12, 2)
  order     Order   @relation(fields: [orderId], references: [id])
  product   Product @relation(fields: [productId], references: [id])

  @@index([orderId], map: "idx_order_items_order_id")
  @@index([productId], map: "idx_order_items_product_id")
  @@map("order_items")
}

model Category {
  id       String    @id @default(uuid()) @db.Uuid
  name     String    @unique @db.VarChar(100)
  products Product[]

  @@map("categories")
}

model Product {
  id          String     @id @default(uuid()) @db.Uuid
  name        String     @db.VarChar(200)
  imageUrl    String     @map("image_url") @db.VarChar(500)
  description String     @db.Text
  price       Decimal    @db.Decimal(12, 2)
  categoryId String?    @map("category_id") @db.Uuid
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz
  category   Category?  @relation(fields: [categoryId], references: [id])
  inventory  Inventory?
  orderItems OrderItem[]

  @@index([categoryId], map: "idx_products_category_id")
  @@map("products")
}

model Inventory {
  productId String   @id @map("product_id") @db.Uuid
  quantity  Int      @default(0)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("inventory")
}
